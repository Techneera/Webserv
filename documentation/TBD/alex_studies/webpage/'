:root
{
    --moonlight: #44CC99;
    --purple: #4400AA;
}

body
{
    height: 97vh;
    border: 1px;
    border-style: solid;
    border-color: red;

    text-align: center;
    font-family: Monospace, Papyrus;
    font-size: 50px;
    background-color: #000000;
    display: flex;
    justify-content: center;
    align-items: center;
}

.div_body
{
    border: 1px;
    border-style: solid;
    border-color: green;

    display: flex;
    justify-content: center;
    align-items: center;
    flex-direction: row;
}

@media (max-width: 1000px)
{
    .div_body
    {
        flex-direction: column;
    }
}

.crazy_button
{
    margin: 35px;
    border: none;
    font-size: 25px;
    text-decoration: none;
    font-weight: bold;
    text-shadow: 2px 2px black;
    padding: 25px;
    color: var(--moonlight);
    background-color: black;
    text-align: center;
    border-radius: 100px;
    box-shadow: 0px 0px 10px 2px #4400AA;
}

.crazy_button:hover
{
    color: --purple;
    box-shadow: 0px 0px 10px 2px --purple;
}

.crazy_button:not(:hover)
{
}

